<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Version>1.0.0</Version>
    <Description>OPC UA client for Scaidome, wrapping the OPC Foundation SDK behind a small API that uses Scaidome.Abstractions types.</Description>
    <PackageTags>scaidome;opcua;opc-ua;client</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scaidome.Abstractions\Scaidome.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="compile": consumers get the SDK at runtime but cannot compile against it. -->
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client" PrivateAssets="compile" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SDK loads this file from the app's output folder, so the package copies it there (contentFiles). -->
    <None Update="Scaidome.OpcUa.Client.Config.xml" Pack="true" PackagePath="contentFiles/any/any/" PackageCopyToOutput="true">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
